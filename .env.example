# PostgreSQL connection string used by Prisma
# URL-encode special characters in the password (@ : / # ? % ! become %40 %3A %2F %23 %3F %25 %21)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# Direct connection used by Prisma migrations (required for Supabase/PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# HMAC secret for location session cookies. Use a long random value.
LOCATION_CSRF_SECRET="replace-me-with-a-long-random-string"

# Public origin of this app. Used as an extra CSRF allow-list entry.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp number with country code, digits only (example: 97798XXXXXXXX).
# Leave empty to let the visitor pick a chat.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
